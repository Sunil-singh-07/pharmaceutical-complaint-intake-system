# Copy this file to `.env` and adjust values as needed.

APP_NAME="Pharmaceutical Complaint Management System"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# LLM Service (Phase 7) - used only for structured information extraction.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30

# Database (Phase 10) - MySQL connection used by the repository layer.
# Either set the individual DB_* fields below, or set DATABASE_URL directly
# to a full SQLAlchemy URL (which takes precedence when set).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharma_complaints
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pharma_complaints
